<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is intentionally off: the app self-updates by replacing its
	     own bundle, and a sandboxed helper process cannot write to
	     /Applications. Distribution is Developer ID + notarization, not the Mac
	     App Store, so the sandbox is not required. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
